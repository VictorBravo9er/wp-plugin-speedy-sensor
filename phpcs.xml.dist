<?xml version="1.0"?>
<ruleset name="Speedy Sensor">
	<description>Coding standards for Speedy Sensor.</description>

	<file>.</file>

	<exclude-pattern>/vendor/*</exclude-pattern>
	<exclude-pattern>/node_modules/*</exclude-pattern>
	<exclude-pattern>/languages/*</exclude-pattern>

	<arg name="extensions" value="php"/>
	<arg name="colors"/>
	<arg name="basepath" value="."/>
	<arg value="ps"/>
	<arg name="parallel" value="8"/>

	<rule ref="WordPress">
		<!-- Admin-only plugin: there is no public/ layer to prefix. -->
		<exclude name="WordPress.Files.FileName.InvalidClassFileName"/>
	</rule>

	<config name="minimum_wp_version" value="6.0"/>
	<config name="testVersion" value="7.4-"/>

	<rule ref="PHPCompatibilityWP"/>

	<rule ref="WordPress.WP.I18n">
		<properties>
			<property name="text_domain" type="array">
				<element value="speedy-sensor"/>
			</property>
		</properties>
	</rule>

	<rule ref="WordPress.NamingConventions.PrefixAllGlobals">
		<properties>
			<property name="prefixes" type="array">
				<element value="speedy_sensor"/>
				<element value="Speedy_Sensor"/>
			</property>
		</properties>
	</rule>

	<!-- PSR-4 class files are PascalCase by definition; the WordPress
	     file-naming sniff expects hyphenated lowercase and cannot coexist with
	     an autoloaded class map. -->
	<rule ref="WordPress.Files.FileName.NotHyphenatedLowercase">
		<exclude-pattern>/includes/*</exclude-pattern>
		<exclude-pattern>/tests/*</exclude-pattern>
	</rule>

	<!-- View::tile() and View::sparkline() build finished markup and escape
	     every argument internally (esc_html/esc_attr), so echoing their
	     return value is safe. WPCS 3.4 cannot express that for a static
	     method call, so each call site carries a justified inline disable. -->

	<!-- bin/ and tests/ are development-only tooling and are export-ignore'd, so
	     they never load inside WordPress. The WordPress-prefix, filesystem and
	     nonce sniffs describe plugin runtime, which they are not part of. -->
	<rule ref="WordPress.NamingConventions.PrefixAllGlobals">
		<exclude-pattern>/bin/*</exclude-pattern>
		<exclude-pattern>/tests/*</exclude-pattern>
	</rule>
	<rule ref="WordPress.WP.AlternativeFunctions">
		<exclude-pattern>/bin/*</exclude-pattern>
	</rule>
	<rule ref="WordPress.Security.NonceVerification">
		<exclude-pattern>/tests/*</exclude-pattern>
	</rule>

	<!-- Raw $wpdb is unavoidable for reporting queries; every call is
	     prepared and the identifiers are allowlisted or interpolated only
	     after a literal match. Inline disables are deliberate. -->
	<rule ref="WordPress.DB.DirectDatabaseQuery">
		<severity>3</severity>
	</rule>
	<rule ref="WordPress.DB.PreparedSQLPlaceholders">
		<severity>3</severity>
	</rule>
</ruleset>