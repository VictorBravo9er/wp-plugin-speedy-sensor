{
	"name": "speedy/speedy-sensor",
	"description": "Backend site health monitor for WordPress: plugin inventory, database footprint, Web Vitals from Speedy.site and optimisation service requests.",
	"type": "wordpress-plugin",
	"license": "GPL-2.0-or-later",
	"require": {
		"php": ">=7.4"
	},
	"require-dev": {
		"squizlabs/php_codesniffer": "^3.9",
		"wp-coding-standards/wpcs": "^3.1",
		"phpcompatibility/phpcompatibility-wp": "^2.1",
		"dealerdirect/phpcodesniffer-composer-installer": "^1.0",
		"phpunit/phpunit": "^9.6",
		"yoast/phpunit-polyfills": "^2.0"
	},
	"autoload": {
		"psr-4": {
			"Speedy_Sensor\\": "includes/"
		}
	},
	"autoload-dev": {
		"psr-4": {
			"Speedy_Sensor\\Tests\\": "tests/"
		}
	},
	"config": {
		"allow-plugins": {
			"dealerdirect/phpcodesniffer-composer-installer": true
		},
		"sort-packages": true
	},
	"scripts": {
		"lint": "phpcs",
		"lint:fix": "phpcbf",
		"test": "phpunit",
		"pot": "@php bin/make-pot.php"
	},
	"scripts-descriptions": {
		"lint": "Run PHPCS over the plugin source.",
		"lint:fix": "Apply PHPCS automatic fixes.",
		"test": "Run the PHPUnit suite against the WordPress test library.",
		"pot": "Regenerate languages/speedy-sensor.pot from source."
	}
}